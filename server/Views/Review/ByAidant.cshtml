@model MediAid.DTOs.CreateReviewDto
@using MediAid.Services
@{
    ViewData["Title"] = "Évaluations de l'aidant";
    var aidant = ViewBag.Aidant as MediAid.Models.Aidant;
    var aidantUser = ViewBag.AidantUser as MediAid.Models.User;
    var reviews = ViewBag.Reviews as List<dynamic> ?? new List<dynamic>();
    var averageRating = ViewBag.AverageRating as double? ?? 0.0;
    var totalReviews = ViewBag.TotalReviews as int? ?? 0;
    var reviewableRequests = ViewBag.ReviewableRequests as List<MediAid.Models.Request> ?? new List<MediAid.Models.Request>();
    var currentUserId = ViewBag.CurrentUserId as string;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="review-page-container">
    <!-- Header Section -->
    <div class="review-page-header">
        <div class="header-content">
            <a href="@Url.Action("Dashboard", "Patient")" class="btn-back-modern">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
            <h1 class="page-title-modern">
                <i class="bi bi-star-fill"></i> Évaluations & Commentaires
            </h1>
        </div>
    </div>

    @if (aidant != null && aidantUser != null)
    {
        <div class="review-content-grid">
            <!-- Left Column: Aidant Profile & Review Form -->
            <div class="review-left-column">
                <!-- Aidant Profile Card -->
                <div class="profile-card-modern">
                    <div class="profile-header-gradient">
                        <div class="profile-avatar-container">
                            <div class="profile-avatar-large">
                                @{
                                    var aidantInitial = aidantUser.FirstName?.Substring(0, 1).ToUpper() ?? "A";
                                }
                                <span>@aidantInitial</span>
                            </div>
                            @if (aidant.IsVerified)
                            {
                                <div class="verified-badge-floating">
                                    <i class="bi bi-shield-check-fill"></i>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <div class="profile-body-modern">
                        <h2 class="aidant-name-modern">@aidantUser.FirstName @aidantUser.LastName</h2>
                        
                        @if (aidant.IsVerified)
                        {
                            <div class="verified-badge-inline">
                                <i class="bi bi-shield-check-fill"></i> Aidant Vérifié
                            </div>
                        }

                        <!-- Rating Display -->
                        <div class="rating-display-modern">
                            <div class="rating-stars-large">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i class="bi bi-star-fill @(i < Math.Floor(averageRating) ? "star-filled" : (i < averageRating ? "star-half" : "star-empty"))"></i>
                                }
                            </div>
                            <div class="rating-info">
                                <span class="rating-value-modern">@averageRating.ToString("F1")</span>
                                <span class="rating-count-modern">(@totalReviews évaluation@(totalReviews > 1 ? "s" : ""))</span>
                            </div>
                        </div>

                        <!-- Stats -->
                        <div class="aidant-stats-modern">
                            <div class="stat-card-mini">
                                <i class="bi bi-trophy-fill"></i>
                                <div>
                                    <div class="stat-value-mini">@aidant.CompletedMissions</div>
                                    <div class="stat-label-mini">Missions complétées</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Review Form Card -->
                @if (!string.IsNullOrEmpty(currentUserId) && reviewableRequests.Any())
                {
                    <div class="review-form-card-modern">
                        <div class="card-header-modern">
                            <h3 class="card-title-modern">
                                <i class="bi bi-pencil-square"></i> Ajouter une évaluation
                            </h3>
                        </div>
                        <div class="card-body-modern">
                            <form asp-action="CreateFromAidantPage" method="post" class="review-form-modern">
                                @Html.AntiForgeryToken()
                                
                                <input type="hidden" asp-for="AidantId" value="@aidant.Id" />
                                
                                <!-- Request Selection -->
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="bi bi-clipboard-check"></i> Mission à évaluer
                                    </label>
                                    <select asp-for="RequestId" class="form-select-modern" required>
                                        <option value="">Sélectionner une mission...</option>
                                        @foreach (var req in reviewableRequests)
                                        {
                                            <option value="@req.Id">@req.Title - @req.CreatedAt.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</option>
                                        }
                                    </select>
                                    <span asp-validation-for="RequestId" class="text-danger"></span>
                                </div>

                                <!-- Rating -->
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="bi bi-star"></i> Note
                                    </label>
                                    <div class="rating-input-container">
                                        <div class="star-rating-input" id="starRating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi bi-star-fill star-input" data-rating="@i"></i>
                                            }
                                        </div>
                                        <input type="hidden" asp-for="Rating" id="ratingValue" value="0" required />
                                        <span class="rating-text" id="ratingText">Sélectionnez une note</span>
                                    </div>
                                    <span asp-validation-for="Rating" class="text-danger"></span>
                                </div>

                                <!-- Comment -->
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="bi bi-chat-left-text"></i> Commentaire (optionnel)
                                    </label>
                                    <textarea asp-for="Comment" class="form-textarea-modern" rows="4" placeholder="Partagez votre expérience avec cet aidant..."></textarea>
                                    <span asp-validation-for="Comment" class="text-danger"></span>
                                </div>

                                <!-- Submit Button -->
                                <button type="submit" class="btn-submit-review">
                                    <i class="bi bi-check-circle"></i> Publier l'évaluation
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(currentUserId) && !reviewableRequests.Any())
                {
                    <div class="info-card-modern">
                        <i class="bi bi-info-circle"></i>
                        <p>Vous n'avez pas de missions complétées avec cet aidant à évaluer pour le moment.</p>
                    </div>
                }
            </div>

            <!-- Right Column: Reviews List -->
            <div class="review-right-column">
                <div class="reviews-card-modern">
                    <div class="card-header-modern">
                        <h3 class="card-title-modern">
                            <i class="bi bi-chat-left-text"></i> Toutes les évaluations
                            <span class="reviews-count-badge">@totalReviews</span>
                        </h3>
                    </div>
                    <div class="card-body-modern">
                        @if (reviews.Any())
                        {
                            <div class="reviews-list-modern">
                                @foreach (var reviewItem in reviews)
                                {
                                    var review = reviewItem.Review as MediAid.Models.Review;
                                    var patientName = reviewItem.PatientName as string ?? "Patient anonyme";
                                    
                                    <div class="review-item-modern">
                                        <div class="review-item-header">
                                            <div class="review-patient-info">
                                                <div class="review-patient-avatar">
                                                    @{
                                                        var patientInitial = patientName.Substring(0, 1).ToUpper();
                                                    }
                                                    <span>@patientInitial</span>
                                                </div>
                                                <div>
                                                    <div class="review-patient-name">@patientName</div>
                                                    <div class="review-date-modern">
                                                        <i class="bi bi-calendar3"></i> @review.CreatedAt.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="review-rating-display">
                                                @for (int i = 0; i < 5; i++)
                                                {
                                                    <i class="bi bi-star-fill @(i < review.Rating ? "star-filled" : "star-empty")"></i>
                                                }
                                            </div>
                                        </div>
                                        
                                        @if (!string.IsNullOrEmpty(review.Comment))
                                        {
                                            <div class="review-comment-modern">
                                                <p>@review.Comment</p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state-modern">
                                <div class="empty-icon-large">
                                    <i class="bi bi-star"></i>
                                </div>
                                <h3>Aucune évaluation</h3>
                                <p>Cet aidant n'a pas encore reçu d'évaluations.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="error-card-modern">
            <i class="bi bi-exclamation-triangle"></i>
            <h3>Aidant introuvable</h3>
            <p>L'aidant demandé n'existe pas.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Star rating interaction
        const stars = document.querySelectorAll('.star-input');
        const ratingValue = document.getElementById('ratingValue');
        const ratingText = document.getElementById('ratingText');

        const ratingTexts = {
            0: 'Sélectionnez une note',
            1: 'Très insatisfait',
            2: 'Insatisfait',
            3: 'Neutre',
            4: 'Satisfait',
            5: 'Très satisfait'
        };

        stars.forEach(star => {
            star.addEventListener('click', function() {
                const rating = parseInt(this.getAttribute('data-rating'));
                ratingValue.value = rating;
                ratingText.textContent = ratingTexts[rating];
                
                stars.forEach((s, index) => {
                    if (index < rating) {
                        s.classList.add('star-selected');
                        s.classList.remove('star-empty');
                    } else {
                        s.classList.remove('star-selected');
                        s.classList.add('star-empty');
                    }
                });
            });

            star.addEventListener('mouseenter', function() {
                const rating = parseInt(this.getAttribute('data-rating'));
                stars.forEach((s, index) => {
                    if (index < rating) {
                        s.style.opacity = '1';
                    } else {
                        s.style.opacity = '0.3';
                    }
                });
            });
        });

        document.getElementById('starRating').addEventListener('mouseleave', function() {
            const currentRating = parseInt(ratingValue.value);
            stars.forEach((s, index) => {
                if (index < currentRating) {
                    s.style.opacity = '1';
                } else {
                    s.style.opacity = '0.3';
                }
            });
        });
    </script>


@model List<MediAid.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">
                <i class="bi bi-bell"></i> Notifications
            </h1>
            <p class="text-muted mb-0">
                Suivez les informations importantes liées à vos demandes, propositions et missions.
            </p>
        </div>

        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-check2-all"></i> Tout marquer comme lu
                </button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card p-4">
            <div class="text-center py-5">
                <i class="bi bi-bell-slash display-4 text-muted"></i>
                <h3 class="mt-3">Aucune notification</h3>
                <p class="text-muted mb-0">Vous n'avez pas encore reçu de notification.</p>
            </div>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var notification in Model)
            {
                <div class="card mb-3 notification-item @(notification.IsRead ? "is-read" : "is-unread")">
                    <div class="card-body d-flex justify-content-between gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                @if (!notification.IsRead)
                                {
                                    <span class="badge bg-primary">Nouveau</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Lu</span>
                                }

                                <span class="badge bg-light text-dark border">
                                    @notification.Type
                                </span>
                            </div>

                            <h5 class="mb-1">@notification.Title</h5>
                            <p class="text-muted mb-2">@notification.Message</p>

                            <small class="text-muted">
                                <i class="bi bi-clock"></i>
                                @notification.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>

                        @if (!notification.IsRead && !string.IsNullOrWhiteSpace(notification.Id))
                        {
                            <form asp-action="MarkAsRead" method="post" class="d-flex align-items-start">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@notification.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    Marquer lu
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>


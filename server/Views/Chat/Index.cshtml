@model MediAid.Models.Request
@{
    ViewData["Title"] = "Chat";
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
    var currentUserName = ViewBag.CurrentUserName as string ?? "Utilisateur";
    var receiverId = ViewBag.ReceiverId as string ?? "";
    var currentUser = ViewBag.CurrentUser as MediAid.Models.User;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/chat-modern.css" asp-append-version="true" />

<div class="whatsapp-chat-container">
    <!-- Chat Header avec glassmorphism -->
    <div class="chat-header-whatsapp">
        <div class="chat-header-left">
            <a href="@Url.Action("Conversations", "Chat")" class="back-btn-mobile">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div class="chat-user-avatar-whatsapp">
                @{
                    var receiverUser = ViewBag.ReceiverUser as MediAid.Models.User;
                    var receiverInitial = receiverUser != null ? receiverUser.FirstName?.Substring(0, 1).ToUpper() ?? "U" : "U";
                }
                <span>@receiverInitial</span>
                <span class="online-status" id="receiverOnlineStatus"></span>
            </div>
            <div class="chat-user-info-whatsapp">
                <div class="chat-user-name-row">
                    <div class="chat-user-name-whatsapp">@(receiverUser != null ? $"{receiverUser.FirstName} {receiverUser.LastName}" : "Utilisateur")</div>
                    @{
                        var receiverRole = receiverUser?.Role ?? "";
                        if (receiverRole == "Aidant")
                        {
                            <span class="verified-badge verified-aidant">
                                <i class="bi bi-shield-check"></i>
                                <span>Verified Aidant</span>
                            </span>
                        }
                        else if (receiverRole == "Patient")
                        {
                            <span class="verified-badge verified-patient">
                                <i class="bi bi-shield-check"></i>
                                <span>Verified Patient</span>
                            </span>
                        }
                    }
                </div>
                <div class="mission-context-subheader">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Discussion regarding Mission <strong>#@((Model.Id ?? "MISSION").Substring(0, Math.Min(8, (Model.Id ?? "MISSION").Length)))</strong> â€” @GetCategoryDisplayName(Model.Category)</span>
                </div>
            </div>
        </div>
        <div class="chat-header-actions-whatsapp">
            @{
                var receiverAidant = ViewBag.ReceiverAidant as MediAid.Models.Aidant;
                var canViewProfile = receiverAidant != null;
            }
            @if (canViewProfile && receiverAidant != null)
            {
                <a href="@Url.Action("Profile", "Aidant", new { id = receiverAidant.Id })" class="header-action-btn" title="Voir le profil">
                    <i class="bi bi-person-circle"></i>
                </a>
            }
            @if (currentUser?.Role == "Aidant")
            {
                <button class="header-action-btn emergency-btn" title="Appel d'urgence" onclick="alert('FonctionnalitÃ© d\'urgence Ã  implÃ©menter')">
                    <i class="bi bi-telephone-fill"></i>
                </button>
            }
            <button class="header-action-btn" title="Support" onclick="window.open('/Home/Privacy', '_blank')">
                <i class="bi bi-question-circle"></i>
            </button>
        </div>
    </div>

    <!-- Messages Area -->
    <div class="messages-area-whatsapp" id="messagesContainer">
        <div class="chat-loading-whatsapp" id="chatLoading">
            <div class="loading-spinner-whatsapp"></div>
        </div>
        <!-- Messages will be loaded here -->
    </div>

    <!-- Typing Indicator -->
    <div class="typing-indicator-whatsapp" id="typingIndicator">
        <div class="typing-bubble">
            <span></span><span></span><span></span>
        </div>
    </div>

    <!-- Quick Actions with Auto-Translation -->
    @if (currentUser?.Role == "Aidant")
    {
        <div class="quick-actions-bar" id="quickActionsBar">
            <button class="quick-action-btn" onclick="sendTranslatedMessage('en_route')" title="Je suis en route / I am on my way / Ø£Ù†Ø§ ÙÙŠ Ø§Ù„Ø·Ø±ÙŠÙ‚">
                <i class="bi bi-geo-alt"></i>
                <span>En route</span>
            </button>
            <button class="quick-action-btn" onclick="sendTranslatedMessage('mission_complete')" title="Mission terminÃ©e / Mission completed / ØªÙ…Øª Ø§Ù„Ù…Ù‡Ù…Ø©">
                <i class="bi bi-check-circle"></i>
                <span>Mission terminÃ©e</span>
            </button>
            <button class="quick-action-btn" onclick="sendTranslatedMessage('at_pharmacy')" title="Je suis Ã  la pharmacie / I am at the pharmacy / Ø£Ù†Ø§ ÙÙŠ Ø§Ù„ØµÙŠØ¯Ù„ÙŠØ©">
                <i class="bi bi-shop"></i>
                <span>Ã€ la pharmacie</span>
            </button>
            <button class="quick-action-btn" onclick="sendTranslatedMessage('arriving_soon')" title="J'arrive dans 5 minutes / Arriving in 5 minutes / Ø³Ø£ØµÙ„ Ø®Ù„Ø§Ù„ 5 Ø¯Ù‚Ø§Ø¦Ù‚">
                <i class="bi bi-clock"></i>
                <span>5 min</span>
            </button>
        </div>
    }
    else if (currentUser?.Role == "Patient")
    {
        <div class="quick-actions-bar" id="quickActionsBar">
            <button class="quick-action-btn" onclick="sendTranslatedMessage('thank_you')" title="Merci / Thank you / Ø´ÙƒØ±Ø§">
                <i class="bi bi-heart"></i>
                <span>Merci</span>
            </button>
            <button class="quick-action-btn" onclick="sendTranslatedMessage('see_you_soon')" title="Ã€ bientÃ´t / See you soon / Ø£Ø±Ø§Ùƒ Ù‚Ø±ÙŠØ¨Ø§">
                <i class="bi bi-hand-thumbs-up"></i>
                <span>Ã€ bientÃ´t</span>
            </button>
        </div>
    }

    <!-- Input Area -->
    <div class="input-area-whatsapp">
        <form id="messageForm" enctype="multipart/form-data">
            <input type="hidden" id="requestId" value="@Model.Id" />
            <input type="hidden" id="receiverId" value="@receiverId" />
            
            <div class="input-wrapper-whatsapp">
                <label for="emojiBtn" class="emoji-btn" title="Emoji">
                    <i class="bi bi-emoji-smile"></i>
                </label>
                
                <label for="fileInput" class="attachment-btn-whatsapp" title="Joindre">
                    <i class="bi bi-paperclip"></i>
                </label>
                <input type="file" id="fileInput" multiple class="d-none" accept="image/*,.pdf,.doc,.docx">
                
                <div class="input-field-container">
                    <textarea id="messageInput" class="message-input-whatsapp" rows="1" placeholder="Tapez un message" style="resize: none;"></textarea>
                    <div id="attachmentPreview" class="attachment-preview-whatsapp"></div>
                </div>
                
                <button type="submit" class="send-btn-whatsapp" id="sendButton">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@7.0.0/dist/browser/signalr.min.js"></script>
    <script>
        // Configuration
        const requestId = document.getElementById('requestId').value;
        const receiverId = document.getElementById('receiverId').value;
        const currentUserId = '@currentUserId';
        const currentUserName = '@currentUserName';
        let selectedFiles = [];
        let isTyping = false;
        let typingTimeout;
        let messageStatusMap = {}; // Track message statuses

        // SignalR Connection - Uses cookie authentication automatically
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chathub", {
                transport: signalR.HttpTransportType.WebSockets | signalR.HttpTransportType.LongPolling,
                skipNegotiation: false,
                withCredentials: true // Important: send cookies with request
            })
            .withAutomaticReconnect({
                nextRetryDelayInMilliseconds: retryContext => {
                    if (retryContext.elapsedMilliseconds < 60000) {
                        return 2000;
                    } else {
                        return null;
                    }
                }
            })
            .configureLogging(signalR.LogLevel.Information)
            .build();

        // Connection Events
        connection.onreconnecting(() => {
            updateReceiverStatus('reconnecting');
        });

        connection.onreconnected(() => {
            updateReceiverStatus('online');
            connection.invoke("JoinRequestGroup", requestId).catch(err => console.error("Rejoin error:", err));
        });

        connection.onclose(() => {
            updateReceiverStatus('offline');
        });

        // Start Connection
        connection.start()
            .then(() => {
                console.log("SignalR Connected");
                updateReceiverStatus('online');
                connection.invoke("JoinRequestGroup", requestId)
                    .then(() => {
                        console.log("Joined request group:", requestId);
                        loadMessages();
                    })
                    .catch(err => console.error("Join group error:", err));
            })
            .catch(err => {
                console.error("SignalR connection error:", err);
                updateReceiverStatus('offline');
                setTimeout(() => connection.start(), 3000);
            });

        // Update Receiver Status
        function updateReceiverStatus(status) {
            const statusDot = document.getElementById('receiverOnlineStatus');
            if (statusDot) {
                statusDot.className = 'online-status status-' + status;
            }
        }

        // Receive Message
        connection.on("ReceiveMessage", (senderId, senderName, content, timestamp, messageId, attachments, status) => {
            addMessageToUI(senderId, senderName, content, timestamp, messageId, attachments || [], status || "sent", false);
            scrollToBottom();
            
            // Mark as delivered when received
            if (senderId !== currentUserId) {
                markMessageAsDelivered(messageId);
                // Auto mark as read after 2 seconds
                setTimeout(() => markMessageAsRead(messageId), 2000);
            }
            
            // Play notification sound
            playNotificationSound();
        });

        // Message Status Updates
        connection.on("MessageDelivered", (messageId) => {
            updateMessageStatus(messageId, "delivered");
        });

        connection.on("MessageRead", (messageId, readerId) => {
            updateMessageStatus(messageId, "read");
        });

        // Typing Indicator
        let typingIndicatorTimeout;
        connection.on("UserTyping", (userName) => {
            if (userName !== currentUserName) {
                document.getElementById('typingIndicator').style.display = 'flex';
                clearTimeout(typingIndicatorTimeout);
                typingIndicatorTimeout = setTimeout(() => {
                    document.getElementById('typingIndicator').style.display = 'none';
                }, 3000);
            }
        });
        
        connection.on("UserStoppedTyping", () => {
            document.getElementById('typingIndicator').style.display = 'none';
        });

        // User Connected/Disconnected
        connection.on("UserConnected", (userId, userName) => {
            if (userId === receiverId) {
                updateReceiverStatus('online');
            }
        });

        connection.on("UserDisconnected", (userId, userName) => {
            if (userId === receiverId) {
                updateReceiverStatus('offline');
            }
        });

        // Send Message
        document.getElementById('messageForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const content = document.getElementById('messageInput').value.trim();
            if (!content && selectedFiles.length === 0) return;

            const sendButton = document.getElementById('sendButton');
            sendButton.disabled = true;
            sendButton.innerHTML = '<div class="spinner-whatsapp"></div>';

            try {
                // Upload files first
                const attachmentUrls = [];
                for (const file of selectedFiles) {
                    const fileData = new FormData();
                    fileData.append('file', file);
                    try {
                        const uploadResponse = await fetch('/Chat/UploadAttachment', {
                            method: 'POST',
                            body: fileData
                        });
                        if (uploadResponse.ok) {
                            const result = await uploadResponse.json();
                            attachmentUrls.push({
                                fileUrl: result.url,
                                fileName: result.fileName,
                                fileType: getFileType(file.name)
                            });
                        }
                    } catch (error) {
                        console.error('Upload error:', error);
                    }
                }

                // Send message via API
                const response = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({
                        requestId: requestId,
                        receiverId: receiverId,
                        content: content,
                        attachmentUrls: attachmentUrls.map(a => a.fileUrl)
                    })
                });

                if (response.ok) {
                    const result = await response.json();
                    // Message will be added via SignalR, but we can add optimistically
                    document.getElementById('messageInput').value = '';
                    selectedFiles = [];
                    document.getElementById('attachmentPreview').innerHTML = '';
                    document.getElementById('fileInput').value = '';
                    updateSendButton();
                    scrollToBottom();
                } else {
                    alert('Erreur lors de l\'envoi du message');
                }
            } catch (error) {
                console.error('Send error:', error);
                alert('Erreur lors de l\'envoi du message');
            } finally {
                sendButton.disabled = false;
                sendButton.innerHTML = '<i class="bi bi-send-fill"></i>';
            }
        });

        // File Input
        document.getElementById('fileInput').addEventListener('change', (e) => {
            selectedFiles = Array.from(e.target.files);
            displayAttachmentPreview();
        });

        function displayAttachmentPreview() {
            const preview = document.getElementById('attachmentPreview');
            preview.innerHTML = '';
            selectedFiles.forEach((file, index) => {
                const div = document.createElement('div');
                div.className = 'attachment-preview-item';
                div.innerHTML = `
                    <i class="bi bi-file-earmark"></i>
                    <span>${file.name}</span>
                    <button type="button" class="remove-attachment-btn" onclick="removeFile(${index})">
                        <i class="bi bi-x"></i>
                    </button>
                `;
                preview.appendChild(div);
            });
            updateSendButton();
        }

        function removeFile(index) {
            selectedFiles.splice(index, 1);
            displayAttachmentPreview();
        }

        function getFileType(fileName) {
            const extension = fileName.split('.').pop().toLowerCase();
            if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(extension)) return 'image';
            if (['pdf', 'doc', 'docx'].includes(extension)) return 'document';
            return 'file';
        }

        // Typing Indicator Input
        document.getElementById('messageInput').addEventListener('input', () => {
            updateSendButton();
            
            if (!isTyping) {
                isTyping = true;
                connection.invoke("Typing", requestId, currentUserName).catch(err => console.error("Typing error:", err));
            }
            
            clearTimeout(typingTimeout);
            typingTimeout = setTimeout(() => {
                isTyping = false;
                connection.invoke("StopTyping", requestId).catch(err => console.error("Stop typing error:", err));
            }, 1000);
        });

        // Auto-resize textarea
        document.getElementById('messageInput').addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });

        function updateSendButton() {
            const input = document.getElementById('messageInput');
            const sendButton = document.getElementById('sendButton');
            if (input.value.trim() || selectedFiles.length > 0) {
                sendButton.disabled = false;
                sendButton.classList.add('active');
            } else {
                sendButton.disabled = true;
                sendButton.classList.remove('active');
            }
        }

        let lastMessageDate = null;

        // Load Messages
        async function loadMessages() {
            try {
                const response = await fetch(`/Chat/GetMessages?requestId=${requestId}`);
                const messages = await response.json();
                
                document.getElementById('chatLoading').style.display = 'none';
                lastMessageDate = null; // Reset for new load
                
                messages.forEach(msg => {
                    addMessageToUI(
                        msg.senderId, 
                        msg.senderName, 
                        msg.content, 
                        msg.timestamp, 
                        msg.id, 
                        msg.attachments || [], 
                        msg.messageStatus || (msg.isRead ? "read" : msg.isDelivered ? "delivered" : "sent"),
                        true
                    );
                });
                scrollToBottom();
                
                // Mark all unread messages as read when conversation is opened
                markAllMessagesAsRead();
            } catch (error) {
                console.error('Load error:', error);
                document.getElementById('chatLoading').innerHTML = '<p style="color: #EF4444;">Erreur lors du chargement</p>';
            }
        }

        function markAllMessagesAsRead() {
            fetch(`/Chat/MarkAllAsRead?requestId=${requestId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            }).then(response => response.json())
              .then(data => {
                  if (data.success) {
                      // Update UI to show all messages as read
                      document.querySelectorAll('.message-bubble-whatsapp[data-message-id]').forEach(bubble => {
                          const statusIcon = bubble.querySelector('.message-status-icon');
                          if (statusIcon) {
                              statusIcon.innerHTML = '<i class="bi bi-check2-all"></i>';
                              statusIcon.classList.add('read');
                          }
                      });
                  }
              })
              .catch(err => console.error('Mark all as read error:', err));
        }

        function formatDateHeader(date) {
            const today = new Date();
            const messageDate = new Date(date);
            const yesterday = new Date(today);
            yesterday.setDate(yesterday.getDate() - 1);
            
            if (messageDate.toDateString() === today.toDateString()) {
                return "Aujourd'hui";
            } else if (messageDate.toDateString() === yesterday.toDateString()) {
                return "Hier";
            } else {
                return messageDate.toLocaleDateString('fr-FR', { 
                    day: 'numeric', 
                    month: 'long', 
                    year: 'numeric' 
                });
            }
        }

        function shouldShowDateHeader(messageDate) {
            if (!lastMessageDate) {
                lastMessageDate = new Date(messageDate);
                return true;
            }
            
            const currentDate = new Date(messageDate);
            const lastDate = new Date(lastMessageDate);
            
            if (currentDate.toDateString() !== lastDate.toDateString()) {
                lastMessageDate = currentDate;
                return true;
            }
            
            return false;
        }

        function addMessageToUI(senderId, senderName, content, timestamp, messageId, attachments, status, isHistorical = false) {
            const container = document.getElementById('messagesContainer');
            
            // Add date separator if needed
            if (shouldShowDateHeader(timestamp)) {
                const dateHeader = document.createElement('div');
                dateHeader.className = 'date-separator';
                dateHeader.innerHTML = `<div class="date-separator-line"></div><span class="date-separator-text">${formatDateHeader(timestamp)}</span><div class="date-separator-line"></div>`;
                container.appendChild(dateHeader);
            }
            
            const messageEl = document.createElement('div');
            const isOwnMessage = senderId === currentUserId;
            
            messageEl.className = `message-wrapper-whatsapp ${isOwnMessage ? 'message-own' : 'message-other'}`;
            messageEl.setAttribute('data-message-id', messageId);
            messageEl.setAttribute('data-sender-id', senderId);

            const time = new Date(timestamp).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
            
            // Store status
            messageStatusMap[messageId] = status;
            
            let attachmentHtml = '';
            if (attachments && attachments.length > 0) {
                attachments.forEach(att => {
                    const fileUrl = att.fileUrl || att.FileUrl || '';
                    const fileName = att.fileName || att.FileName || 'Fichier';
                    const fileType = att.fileType || att.FileType || '';
                    
                    if (fileType === 'image' || fileUrl.match(/\.(jpg|jpeg|png|gif|webp)$/i)) {
                        attachmentHtml += `
                            <div class="message-attachment-whatsapp image-attachment">
                                <img src="${fileUrl}" alt="${fileName}" onclick="openImageModal('${fileUrl}')">
                            </div>
                        `;
                    } else {
                        attachmentHtml += `
                            <div class="message-attachment-whatsapp file-attachment">
                                <a href="${fileUrl}" target="_blank" class="file-link-whatsapp">
                                    <i class="bi bi-file-earmark"></i>
                                    <span>${fileName}</span>
                                </a>
                            </div>
                        `;
                    }
                });
            }

            const statusIcon = isOwnMessage ? getStatusIcon(status) : '';
            
            messageEl.innerHTML = `
                <div class="message-bubble-whatsapp">
                    ${attachmentHtml}
                    ${content ? `<div class="message-text-whatsapp">${escapeHtml(content)}</div>` : ''}
                </div>
                <div class="message-meta-whatsapp">
                    <span class="message-time-whatsapp">${time}</span>
                    ${statusIcon}
                    ${isOwnMessage && status === 'read' ? '<span class="read-indicator">Lu</span>' : ''}
                </div>
            `;
            
            container.appendChild(messageEl);
            
            if (!isHistorical) {
                scrollToBottom();
            }
            
            // Mark as delivered when visible (for received messages)
            if (!isOwnMessage && status === "sent") {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            markMessageAsDelivered(messageId);
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.5 });
                observer.observe(messageEl);
            }
        }

        function getStatusIcon(status) {
            switch(status) {
                case 'read':
                    return '<span class="message-status read"><i class="bi bi-check2-all"></i></span>';
                case 'delivered':
                    return '<span class="message-status delivered"><i class="bi bi-check2-all"></i></span>';
                case 'sent':
                default:
                    return '<span class="message-status sent"><i class="bi bi-check"></i></span>';
            }
        }

        function updateMessageStatus(messageId, newStatus) {
            const messageEl = document.querySelector(`[data-message-id="${messageId}"]`);
            if (messageEl) {
                const statusEl = messageEl.querySelector('.message-status');
                if (statusEl) {
                    messageStatusMap[messageId] = newStatus;
                    statusEl.outerHTML = getStatusIcon(newStatus);
                    // Si le message est lu, ajouter l'indicateur "Lu"
                    if (newStatus === 'read') {
                        const footer = messageEl.querySelector('.message-footer-whatsapp');
                        if (footer && !footer.querySelector('.read-indicator')) {
                            const readIndicator = document.createElement('span');
                            readIndicator.className = 'read-indicator';
                            readIndicator.textContent = 'Lu';
                            readIndicator.style.cssText = 'font-size: 0.625rem; opacity: 0.8; margin-left: 0.25rem;';
                            footer.appendChild(readIndicator);
                        }
                    }
                }
            }
        }

        function markMessageAsDelivered(messageId) {
            fetch(`/Chat/MarkAsDelivered?messageId=${messageId}`, { 
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            }).catch(err => console.error('Mark delivered error:', err));
        }

        function markMessageAsRead(messageId) {
            fetch(`/Chat/MarkAsRead?messageId=${messageId}`, { 
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            }).catch(err => console.error('Mark read error:', err));
        }

        function scrollToBottom() {
            const container = document.getElementById('messagesContainer');
            container.scrollTop = container.scrollHeight;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function playNotificationSound() {
            // Optional: Play a subtle notification sound
            const audio = new Audio('data:audio/wav;base64,');
            audio.volume = 0.2;
            audio.play().catch(() => {});
        }

        function openImageModal(imageUrl) {
            const modal = document.createElement('div');
            modal.className = 'image-modal-whatsapp';
            modal.innerHTML = `
                <div class="image-modal-content-whatsapp">
                    <button class="image-modal-close-whatsapp">&times;</button>
                    <img src="${imageUrl}" alt="Image">
                </div>
            `;
            document.body.appendChild(modal);
            
            modal.querySelector('.image-modal-close-whatsapp').addEventListener('click', () => modal.remove());
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.remove();
            });
        }

        // Quick Actions with Auto-Translation
        const translatedMessages = {
            'en_route': { fr: 'Je suis en route', en: 'I am on my way', ar: 'Ø£Ù†Ø§ ÙÙŠ Ø§Ù„Ø·Ø±ÙŠÙ‚' },
            'mission_complete': { fr: 'Mission terminÃ©e', en: 'Mission completed', ar: 'ØªÙ…Øª Ø§Ù„Ù…Ù‡Ù…Ø©' },
            'at_pharmacy': { fr: 'Je suis Ã  la pharmacie', en: 'I am at the pharmacy', ar: 'Ø£Ù†Ø§ ÙÙŠ Ø§Ù„ØµÙŠØ¯Ù„ÙŠØ©' },
            'arriving_soon': { fr: "J'arrive dans 5 minutes", en: 'Arriving in 5 minutes', ar: 'Ø³Ø£ØµÙ„ Ø®Ù„Ø§Ù„ 5 Ø¯Ù‚Ø§Ø¦Ù‚' },
            'thank_you': { fr: 'Merci beaucoup', en: 'Thank you very much', ar: 'Ø´ÙƒØ±Ø§ Ø¬Ø²ÙŠÙ„Ø§' },
            'see_you_soon': { fr: 'Ã€ bientÃ´t', en: 'See you soon', ar: 'Ø£Ø±Ø§Ùƒ Ù‚Ø±ÙŠØ¨Ø§' }
        };

        function sendTranslatedMessage(messageKey) {
            // Detect language preference (could be from user profile)
            const userLang = navigator.language || 'fr-FR';
            let lang = 'fr';
            if (userLang.startsWith('en')) lang = 'en';
            else if (userLang.startsWith('ar')) lang = 'ar';
            
            const message = translatedMessages[messageKey]?.[lang] || translatedMessages[messageKey]?.fr || messageKey;
            document.getElementById('messageInput').value = message;
            document.getElementById('messageForm').dispatchEvent(new Event('submit'));
        }

        // Legacy function for backward compatibility
        function sendQuickMessage(text) {
            document.getElementById('messageInput').value = text;
            document.getElementById('messageForm').dispatchEvent(new Event('submit'));
        }

        // Initialize
        updateSendButton();
    </script>
}

@functions {
    private string GetCategoryDisplayName(string category)
    {
        return category switch
        {
            "Transport" => "Transport",
            "Medication" => "Medication Pickup",
            "Accompaniment" => "Accompaniment",
            "LightAssistance" => "Light Assistance",
            "PostHospitalization" => "Post-Hospitalization",
            _ => category
        };
    }
}


@{
    ViewData["Title"] = "Confidentialité";
}

<link rel="stylesheet" href="~/css/privacy-professional.css" asp-append-version="true" />

<div class="privacy-page-professional">
    <!-- Header Section -->
    <div class="privacy-header-professional">
        <div class="header-content-privacy">
            <div class="title-section-privacy">
                <h1 class="page-title-privacy">
                    <i class="bi bi-shield-lock"></i> Confidentialité et Protection des données
                </h1>
                <p class="page-subtitle-privacy">Votre vie privée est importante pour nous</p>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="privacy-main-card neumorphic-card">
        <div class="card-header-modern">
            <h2 class="card-title-modern">
                <i class="bi bi-info-circle"></i> Politique de confidentialité
            </h2>
        </div>
        <div class="card-body-modern">
            <p>
                MediAid s'engage à protéger votre vie privée et vos données personnelles. 
                Nous utilisons des mesures de sécurité avancées pour garantir la confidentialité de vos informations médicales.
            </p>
        </div>
    </div>

    <!-- Privacy Features Grid -->
    <div class="privacy-grid-professional">
        <div class="privacy-feature-card">
            <div class="privacy-icon-wrapper-professional">
                <i class="bi bi-shield-check"></i>
            </div>
            <h3>Données sécurisées</h3>
            <p>Toutes vos données sont chiffrées et stockées en toute sécurité.</p>
        </div>

        <div class="privacy-feature-card">
            <div class="privacy-icon-wrapper-professional">
                <i class="bi bi-person-x"></i>
            </div>
            <h3>Anonymisation</h3>
            <p>Vos informations personnelles sont anonymisées lorsque nécessaire.</p>
        </div>

        <div class="privacy-feature-card">
            <div class="privacy-icon-wrapper-professional">
                <i class="bi bi-eye-slash"></i>
            </div>
            <h3>Confidentialité</h3>
            <p>Seuls les aidants acceptés peuvent voir vos informations.</p>
        </div>

        <div class="privacy-feature-card">
            <div class="privacy-icon-wrapper-professional">
                <i class="bi bi-file-earmark-lock"></i>
            </div>
            <h3>Conformité RGPD</h3>
            <p>Nous respectons les réglementations européennes sur la protection des données.</p>
        </div>
    </div>
</div>


        height: 350px;
        background: rgba(14, 165, 233, 0.15);
        top: 50%;
        right: 10%;
        animation-delay: 14s;
    }

    @@keyframes blob-animation {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }
        33% {
            transform: translate(30px, -30px) scale(1.1);
        }
        66% {

@{
    ViewData["Title"] = "Accueil";
    Layout = "_Layout";
}

<!-- 1️⃣ HERO SECTION (FIRST SCREEN – MOST IMPORTANT) -->
<section class="hero-section-enhanced" data-aos="fade-in">
    <!-- Abstract Blob Shapes Background -->
    <div class="hero-blob-shapes">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
    </div>
    
    <div class="container">
        <div class="hero-split-layout">
            <!-- Left Side: Text & Buttons -->
            <div class="hero-left">
                <!-- Trust Badge -->
                <div class="trust-badge-pill" data-aos="fade-up">
                    <span class="badge-icon">✨</span>
                    <span class="badge-text">Trusted by @(ViewBag.TotalUsers > 0 ? ViewBag.TotalUsers.ToString("N0") : "0")+ @(ViewBag.TotalUsers == 1 ? "family" : "families")</span>
                </div>
                
                <h1 class="hero-main-title-enhanced" data-aos="fade-up" data-aos-delay="50">
                    Connecting Patients with <span class="highlight-trusted">Trusted <span class="gradient-text-human">Human Support</span></span>
                    <span class="squiggle-underline"></span>
                </h1>
                <p class="hero-subtitle-enhanced" data-aos="fade-up" data-aos-delay="100">
                    A secure platform that connects patients, caregivers, volunteers, and experts to provide real human support when it matters most.
                </p>
                
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="hero-cta-group-enhanced" data-aos="fade-up" data-aos-delay="200">
                        <a asp-controller="Account" asp-action="Register" class="btn-hero-primary-gradient" data-role="patient">
                            <div class="btn-background-icon">
                                <i class="bi bi-person"></i>
                            </div>
                            <div class="btn-avatar-group">
                                <div class="btn-avatar avatar-1">👤</div>
                                <div class="btn-avatar avatar-2">👩</div>
                                <div class="btn-avatar avatar-3">👨</div>
                            </div>
                            <i class="bi bi-person-heart"></i>
                            <span>I am a Patient</span>
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn-hero-primary-gradient" data-role="aidant">
                            <div class="btn-background-icon">
                                <i class="bi bi-people"></i>
                            </div>
                            <div class="btn-avatar-group">
                                <div class="btn-avatar avatar-4">👨‍⚕️</div>
                                <div class="btn-avatar avatar-5">👩‍⚕️</div>
                                <div class="btn-avatar avatar-6">🤝</div>
                            </div>
                            <i class="bi bi-people-fill"></i>
                            <span>I want to Help</span>
                        </a>
                    </div>
                    <div class="hero-cta-secondary-enhanced" data-aos="fade-up" data-aos-delay="300">
                        <a asp-controller="Account" asp-action="Login" class="btn-hero-glassmorphic">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Login</span>
                        </a>
                        <a href="#how-it-works-preview" class="btn-hero-glassmorphic">
                            <i class="bi bi-info-circle"></i>
                            <span>Discover How It Works</span>
                        </a>
                    </div>
                    
                    <!-- Trust Bar with Partner Logos -->
                    <div class="trust-bar-partners" data-aos="fade-up" data-aos-delay="400">
                        <div class="trust-bar-label">Trusted by</div>
                        <div class="trust-logos-grid">
                            <div class="trust-logo-item">
                                <i class="bi bi-shield-check"></i>
                                <span>GDPR</span>
                            </div>
                            <div class="trust-logo-item">
                                <i class="bi bi-lock-fill"></i>
                                <span>HIPAA</span>
                            </div>
                            <div class="trust-logo-item">
                                <i class="bi bi-hospital"></i>
                                <span>Medical</span>
                            </div>
                            <div class="trust-logo-item">
                                <i class="bi bi-award-fill"></i>
                                <span>Certified</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="hero-cta-group-enhanced" data-aos="fade-up" data-aos-delay="200">
                        <a asp-controller="Dashboard" asp-action="Index" class="btn-hero-primary-gradient">
                            <i class="bi bi-speedometer2"></i>
                            <span>Go to Dashboard</span>
                        </a>
                    </div>
                }
            </div>
            
            <!-- Right Side: 3D Visual Element -->
            <div class="hero-right" data-aos="fade-left" data-aos-delay="200">
                <div class="hero-visual-container parallax-container">
                    <div class="floating-mockup">
                        <div class="mockup-card">
                            <div class="mockup-header">
                                <div class="mockup-avatar-large">👩‍⚕️</div>
                                <div class="mockup-info">
                                    <div class="mockup-name">Dr. Sarah Chen</div>
                                    <div class="mockup-role">Certified Caregiver</div>
                                </div>
                                <div class="mockup-badge-verified">
                                    <i class="bi bi-shield-check"></i>
                                </div>
                            </div>
                            <div class="mockup-stats">
                                <div class="mockup-stat">
                                    <div class="stat-value">@(ViewBag.PatientsHelped ?? 0)</div>
                                    <div class="stat-label">Helped</div>
                                </div>
                                <div class="mockup-stat">
                                    <div class="stat-value">@(ViewBag.AverageRating > 0 ? ViewBag.AverageRating.ToString("F1") : "0.0")</div>
                                    <div class="stat-label">Rating</div>
                                </div>
                                <div class="mockup-stat">
                                    <div class="stat-value">@(ViewBag.AvailableAidants ?? 0)</div>
                                    <div class="stat-label">Available</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="hero-illustration parallax-layer-1">
                        <div class="illustration-circle circle-1"></div>
                        <div class="illustration-circle circle-2"></div>
                    </div>
                    <!-- 3D Medical Illustration with Glow -->
                    <div class="medical-illustration-3d">
                        <div class="glow-effect-pulse"></div>
                        <div class="medical-icon-heart">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Professional Trust Row -->
    <div class="professional-trust-row" data-aos="fade-up" data-aos-delay="400">
        <div class="container">
            <div class="trust-row-content">
                <div class="trust-live-counter">
                    <span class="live-indicator"></span>
                    <span class="live-text">Live: <span class="live-number" data-count="@(ViewBag.AvailableAidants ?? 0)">0</span> Aidants available</span>
                </div>
                <div class="trust-security-icons">
                    <div class="security-icon-item" data-tooltip="Data Encryption">
                        <i class="bi bi-lock-fill"></i>
                        <span>Encrypted</span>
                    </div>
                    <div class="security-icon-item" data-tooltip="Identity Verified">
                        <i class="bi bi-shield-check-fill"></i>
                        <span>Verified</span>
                    </div>
                    <div class="security-icon-item" data-tooltip="24/7 Support">
                        <i class="bi bi-clock-fill"></i>
                        <span>24/7</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Trust Bar (Social Proof) -->
    <div class="trust-bar-enhanced" data-aos="fade-up" data-aos-delay="450">
        <div class="container">
            <div class="trust-bar-content">
                <span class="trust-label">Trusted by</span>
                <div class="trust-logos">
                    <div class="trust-logo-item">GDPR</div>
                    <div class="trust-logo-item">HIPAA</div>
                    <div class="trust-logo-item">ISO 27001</div>
                    <div class="trust-logo-item">SOC 2</div>
                </div>
                <span class="trust-divider">|</span>
                <span class="trust-label">As seen in</span>
                <div class="trust-logos">
                    <div class="trust-logo-item">TechCrunch</div>
                    <div class="trust-logo-item">HealthTech</div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Live Impact Counter -->
    <div class="impact-counter-section" data-aos="fade-up" data-aos-delay="500">
        <div class="container">
            <div class="impact-counter-grid">
                <div class="impact-counter-item">
                    <div class="impact-number" data-count="@(ViewBag.TotalAidants ?? 0)">0</div>
                    <div class="impact-label">+ Active Caregivers</div>
                </div>
                <div class="impact-counter-item">
                    <div class="impact-number" data-count="@(ViewBag.CompletedRequests ?? 0)">0</div>
                    <div class="impact-label">+ Successful Matches</div>
                </div>
                <div class="impact-counter-item">
                    <div class="impact-icon"><i class="bi bi-shield-check"></i></div>
                    <div class="impact-label">24/7 Expert Supervision</div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- How It Works Preview -->
    <div class="how-it-works-preview" id="how-it-works-preview" data-aos="fade-up" data-aos-delay="600">
        <div class="container">
            <div class="how-it-works-preview-grid">
                <div class="how-it-works-preview-item">
                    <div class="preview-icon">
                        <i class="bi bi-file-earmark-plus"></i>
                    </div>
                    <h4 class="preview-title">Post</h4>
                    <p class="preview-description">Tell us what you need</p>
                </div>
                <div class="how-it-works-preview-connector">
                    <i class="bi bi-arrow-right"></i>
                </div>
                <div class="how-it-works-preview-item">
                    <div class="preview-icon">
                        <i class="bi bi-search-heart"></i>
                    </div>
                    <h4 class="preview-title">Match</h4>
                    <p class="preview-description">We find a verified assistant</p>
                </div>
                <div class="how-it-works-preview-connector">
                    <i class="bi bi-arrow-right"></i>
                </div>
                <div class="how-it-works-preview-item">
                    <div class="preview-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4 class="preview-title">Support</h4>
                    <p class="preview-description">Receive care in a secure environment</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2️⃣ PLATFORM IDENTITY SECTION -->
<section class="platform-identity-section" id="platform-identity">
    <div class="container">
        <h2 class="section-title-center" data-aos="fade-up">What is this platform?</h2>
        <div class="pillars-grid" data-aos="fade-up" data-aos-delay="100">
            <div class="pillar-card">
                <div class="pillar-icon">
                    <i class="bi bi-hospital"></i>
                </div>
                <h3 class="pillar-title">Patient-Centered Care</h3>
                <p class="pillar-description">Every request is designed around the patient's needs, ensuring personalized and compassionate support.</p>
            </div>
            
            <div class="pillar-card">
                <div class="pillar-icon">
                    <i class="bi bi-people"></i>
                </div>
                <h3 class="pillar-title">Human Support & Solidarity</h3>
                <p class="pillar-description">Real people helping real people. Building a community of care and mutual support.</p>
            </div>
            
            <div class="pillar-card">
                <div class="pillar-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h3 class="pillar-title">Secure & Confidential</h3>
                <p class="pillar-description">GDPR-compliant with encrypted data, role-based access, and strict privacy protocols.</p>
            </div>
            
            <div class="pillar-card">
                <div class="pillar-icon">
                    <i class="bi bi-globe"></i>
                </div>
                <h3 class="pillar-title">Community-Based Help</h3>
                <p class="pillar-description">Local connections, availability-based matching, and community-driven solutions.</p>
            </div>
        </div>
    </div>
</section>

<!-- 3️⃣ HOW IT WORKS SECTION -->
<section class="how-it-works-section" id="how-it-works">
    <div class="container">
        <h2 class="section-title-center" data-aos="fade-up">How It Works</h2>
        <p class="section-subtitle-center" data-aos="fade-up" data-aos-delay="50">Simple steps to get the support you need or start helping others</p>
        
        <div class="steps-timeline" data-aos="fade-up" data-aos-delay="100">
            <div class="step-card">
                <div class="step-number">1</div>
                <div class="step-icon-wrapper">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <h3 class="step-title">Create an Account</h3>
                <p class="step-description">Choose your role: Patient, Aidant, Expert, or Administrator. Quick and secure registration process.</p>
            </div>
            
            <div class="step-connector">
                <i class="bi bi-arrow-right"></i>
            </div>
            
            <div class="step-card">
                <div class="step-number">2</div>
                <div class="step-icon-wrapper">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </div>
                <h3 class="step-title">Submit or Find Requests</h3>
                <p class="step-description">Patients create help requests. Aidants browse and find matching missions based on location and availability.</p>
            </div>
            
            <div class="step-connector">
                <i class="bi bi-arrow-right"></i>
            </div>
            
            <div class="step-card">
                <div class="step-number">3</div>
                <div class="step-icon-wrapper">
                    <i class="bi bi-chat-dots-fill"></i>
                </div>
                <h3 class="step-title">Connect Securely</h3>
                <p class="step-description">Built-in messaging system for secure communication. Plan meetings and coordinate support activities.</p>
            </div>
            
            <div class="step-connector">
                <i class="bi bi-arrow-right"></i>
            </div>
            
            <div class="step-card">
                <div class="step-number">4</div>
                <div class="step-icon-wrapper">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h3 class="step-title">Support & Follow-Up</h3>
                <p class="step-description">Track missions, provide evaluations, and measure impact. Complete transparency and accountability.</p>
            </div>
        </div>
    </div>
</section>

<!-- 4️⃣ ROLES OVERVIEW SECTION -->
<section class="roles-overview-section">
    <div class="container">
        <h2 class="section-title-center" data-aos="fade-up">One Platform — Multiple Roles — One Mission</h2>
        <p class="section-subtitle-center" data-aos="fade-up" data-aos-delay="50">Discover how each role contributes to our mission of care</p>
        
        <div class="roles-grid" data-aos="fade-up" data-aos-delay="100">
            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-person-heart"></i>
                </div>
                <h3 class="role-title">Patient</h3>
                <ul class="role-benefits">
                    <li><i class="bi bi-check-circle-fill"></i> Create secure help requests</li>
                    <li><i class="bi bi-check-circle-fill"></i> Receive qualified proposals</li>
                    <li><i class="bi bi-check-circle-fill"></i> Track your support history</li>
                </ul>
                <a href="#" class="role-learn-more">Learn more <i class="bi bi-arrow-right"></i></a>
            </div>
            
            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h3 class="role-title">Aidant / Volunteer</h3>
                <ul class="role-benefits">
                    <li><i class="bi bi-check-circle-fill"></i> Browse available missions</li>
                    <li><i class="bi bi-check-circle-fill"></i> Propose your help</li>
                    <li><i class="bi bi-check-circle-fill"></i> Build your volunteer profile</li>
                </ul>
                <a href="#" class="role-learn-more">Learn more <i class="bi bi-arrow-right"></i></a>
            </div>
            
            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h3 class="role-title">Expert</h3>
                <ul class="role-benefits">
                    <li><i class="bi bi-check-circle-fill"></i> Validate sensitive requests</li>
                    <li><i class="bi bi-check-circle-fill"></i> Supervise mission quality</li>
                    <li><i class="bi bi-check-circle-fill"></i> Ensure ethical compliance</li>
                </ul>
                <a href="#" class="role-learn-more">Learn more <i class="bi bi-arrow-right"></i></a>
            </div>
            
            <div class="role-card">
                <div class="role-icon">
                    <i class="bi bi-gear-fill"></i>
                </div>
                <h3 class="role-title">Administrator</h3>
                <ul class="role-benefits">
                    <li><i class="bi bi-check-circle-fill"></i> Manage platform users</li>
                    <li><i class="bi bi-check-circle-fill"></i> Monitor system activity</li>
                    <li><i class="bi bi-check-circle-fill"></i> Ensure platform security</li>
                </ul>
                <a href="#" class="role-learn-more">Learn more <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section>

<!-- 5️⃣ KEY FEATURES HIGHLIGHT -->
<section class="features-highlight-section">
    <div class="container">
        <h2 class="section-title-center" data-aos="fade-up">Why Choose Our Platform?</h2>
        <p class="section-subtitle-center" data-aos="fade-up" data-aos-delay="50">Built for trust, designed for impact</p>
        
        <div class="features-grid" data-aos="fade-up" data-aos-delay="100">
            <div class="feature-block">
                <div class="feature-block-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h4 class="feature-block-title">Secure Role-Based Access</h4>
                <p class="feature-block-text">Each user has appropriate permissions. No unauthorized access, complete data protection.</p>
            </div>
            
            <div class="feature-block">
                <div class="feature-block-icon">
                    <i class="bi bi-list-check"></i>
                </div>
                <h4 class="feature-block-title">Structured Requests & Missions</h4>
                <p class="feature-block-text">Clear workflow from request creation to mission completion with full traceability.</p>
            </div>
            
            <div class="feature-block">
                <div class="feature-block-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <h4 class="feature-block-title">Availability-Based Matching</h4>
                <p class="feature-block-text">Smart matching system connects patients with nearby available aidants.</p>
            </div>
            
            <div class="feature-block">
                <div class="feature-block-icon">
                    <i class="bi bi-chat-left-text-fill"></i>
                </div>
                <h4 class="feature-block-title">Integrated Messaging</h4>
                <p class="feature-block-text">Built-in secure messaging for coordination and communication.</p>
            </div>
            
            <div class="feature-block">
                <div class="feature-block-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <h4 class="feature-block-title">History & Tracking</h4>
                <p class="feature-block-text">Complete mission history, evaluations, and impact tracking for transparency.</p>
            </div>
            
            <div class="feature-block">
                <div class="feature-block-icon">
                    <i class="bi bi-eye-fill"></i>
                </div>
                <h4 class="feature-block-title">Transparency & Accountability</h4>
                <p class="feature-block-text">Full audit logs, transparent processes, and ethical compliance monitoring.</p>
            </div>
            
            <div class="feature-block">
                <div class="feature-block-icon">
                    <i class="bi bi-heart-fill"></i>
                </div>
                <h4 class="feature-block-title">Ethical & Human-Centered Design</h4>
                <p class="feature-block-text">No AI automation. Real human trust, real human care, real human safety.</p>
            </div>
        </div>
    </div>
</section>

<!-- 6️⃣ TRUST & CREDIBILITY SECTION -->
<section class="trust-credibility-section">
    <div class="container">
        <h2 class="section-title-center" data-aos="fade-up">Security & Ethics</h2>
        <p class="trust-message" data-aos="fade-up" data-aos-delay="50">Your data and dignity are our priority.</p>
        
        <div class="trust-cards-grid" data-aos="fade-up" data-aos-delay="100">
            <div class="trust-card">
                <div class="trust-card-icon">
                    <i class="bi bi-file-earmark-lock-fill"></i>
                </div>
                <h4 class="trust-card-title">GDPR-Compliant</h4>
                <p class="trust-card-text">Full compliance with European data protection regulations. Your privacy is protected.</p>
            </div>
            
            <div class="trust-card">
                <div class="trust-card-icon">
                    <i class="bi bi-key-fill"></i>
                </div>
                <h4 class="trust-card-title">Role-Based Permissions</h4>
                <p class="trust-card-text">Strict access control. Users only see and access what they need for their role.</p>
            </div>
            
            <div class="trust-card">
                <div class="trust-card-icon">
                    <i class="bi bi-lock-fill"></i>
                </div>
                <h4 class="trust-card-title">Encrypted Passwords</h4>
                <p class="trust-card-text">BCrypt hashing for all passwords. Industry-standard security practices.</p>
            </div>
            
            <div class="trust-card">
                <div class="trust-card-icon">
                    <i class="bi bi-shield-check-fill"></i>
                </div>
                <h4 class="trust-card-title">Moderation & Reporting</h4>
                <p class="trust-card-text">Expert supervision, reporting system, and continuous monitoring for safety.</p>
            </div>
            
            <div class="trust-card">
                <div class="trust-card-icon">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </div>
                <h4 class="trust-card-title">Ethical Charter</h4>
                <p class="trust-card-text">All users sign an ethical charter committing to respect, dignity, and professional conduct.</p>
            </div>
        </div>
    </div>
</section>

<!-- 7️⃣ STATISTICS / IMPACT SECTION -->
<section class="statistics-section">
    <div class="container">
        <h2 class="section-title-center" data-aos="fade-up">Our Impact</h2>
        <div class="statistics-grid" data-aos="fade-up" data-aos-delay="100">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-number" data-count="@(ViewBag.TotalUsers ?? 0)">0</div>
                <div class="stat-label">+ Users</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div class="stat-number" data-count="@(ViewBag.CompletedRequests ?? 0)">0</div>
                <div class="stat-label">+ Missions Completed</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-star-fill"></i>
                </div>
                <div class="stat-number" data-count="@(ViewBag.AverageRating > 0 ? (int)(ViewBag.AverageRating * 20) : 0)">0</div>
                <div class="stat-label">% Satisfaction</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-clock-fill"></i>
                </div>
                <div class="stat-number" data-count="@(ViewBag.TotalVolunteerHours ?? 0)">0</div>
                <div class="stat-label">+ Volunteer Hours</div>
            </div>
        </div>
    </div>
</section>

<!-- 8️⃣ USER TESTIMONIALS -->
<section class="testimonials-section">
    <div class="container">
        <h2 class="section-title-center" data-aos="fade-up">What Our Users Say</h2>
        <p class="section-subtitle-center" data-aos="fade-up" data-aos-delay="50">Real stories from real people</p>
        
        <div class="testimonials-grid" data-aos="fade-up" data-aos-delay="100">
            <div class="testimonial-card-modern">
                <div class="testimonial-quote">
                    <i class="bi bi-quote"></i>
                </div>
                <p class="testimonial-text-modern">"This platform helped me feel supported when I needed it most. The aidant was professional, kind, and exactly what I needed."</p>

@{
    ViewData["Title"] = "MediAid - Healthcare Assistance Platform";
}

<link rel="stylesheet" href="~/css/home-pro.css" asp-append-version="true" />

<div class="ma-home">
    <section class="ma-hero">
        <div class="ma-hero-content">
            <div class="ma-eyebrow">
                <span class="ma-status-dot"></span>
                Healthcare assistance workflow platform
            </div>

            <h1>
                Coordinate healthcare assistance with structure, trust, and human support.
            </h1>

            <p class="ma-hero-text">
                MediAid connects patients, aidants, experts, and administrators through a complete workflow:
                request creation, expert validation, aidant proposals, mission tracking, proof submission,
                patient verification, notifications, and reviews.
            </p>

            <div class="ma-actions">
                <a asp-controller="Account" asp-action="Register" class="ma-btn ma-btn-primary">
                    Create an account
                </a>
                <a asp-controller="Account" asp-action="Login" class="ma-btn ma-btn-secondary">
                    Login
                </a>
            </div>

            <div class="ma-trust-row">
                <div>
                    <strong>Role-based access</strong>
                    <span>Patient, Aidant, Expert, Admin</span>
                </div>
                <div>
                    <strong>Mission verification</strong>
                    <span>Proof before completion</span>
                </div>
                <div>
                    <strong>MongoDB persistence</strong>
                    <span>Real backend storage</span>
                </div>
            </div>
        </div>

        <div class="ma-hero-panel">
            <div class="ma-panel-header">
                <span>Live workflow</span>
                <strong>MediAid</strong>
            </div>

            <div class="ma-flow">
                <div class="ma-flow-step active">
                    <span>01</span>
                    <div>
                        <strong>Patient request</strong>
                        <p>A patient creates an assistance request.</p>
                    </div>
                </div>

                <div class="ma-flow-step">
                    <span>02</span>
                    <div>
                        <strong>Expert validation</strong>
                        <p>Sensitive requests can be validated before publication.</p>
                    </div>
                </div>

                <div class="ma-flow-step">
                    <span>03</span>
                    <div>
                        <strong>Aidant proposal</strong>
                        <p>Aidants can propose help for validated requests.</p>
                    </div>
                </div>

                <div class="ma-flow-step">
                    <span>04</span>
                    <div>
                        <strong>Verified mission</strong>
                        <p>Mission completion requires proof and patient verification.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="ma-section">
        <div class="ma-section-heading">
            <span>Platform modules</span>
            <h2>One system for the full assistance lifecycle</h2>
            <p>
                The homepage now describes the actual implemented project instead of showing fake company claims,
                fake testimonials, or artificial impact statistics.
            </p>
        </div>

        <div class="ma-grid">
            <article class="ma-card">
                <div class="ma-icon">P</div>
                <h3>Patient Space</h3>
                <p>Create requests, follow proposals, verify missions, receive notifications, and review completed assistance.</p>
            </article>

            <article class="ma-card">
                <div class="ma-icon">A</div>
                <h3>Aidant Space</h3>
                <p>Browse validated requests, send proposals, manage assigned missions, and upload proof after intervention.</p>
            </article>

            <article class="ma-card">
                <div class="ma-icon">E</div>
                <h3>Expert Space</h3>
                <p>Review sensitive requests before they become available to aidants, improving platform safety and consistency.</p>
            </article>

            <article class="ma-card">
                <div class="ma-icon">M</div>
                <h3>Admin Space</h3>
                <p>Supervise users, monitor activity, review logs, and keep the platform organized through administrative tools.</p>
            </article>
        </div>
    </section>

    <section class="ma-section ma-workflow-section">
        <div class="ma-section-heading">
            <span>Core workflow</span>
            <h2>From request to verified completion</h2>
            <p>
                MediAid is structured around a real backend workflow, not a static landing page.
            </p>
        </div>

        <div class="ma-timeline">
            <div class="ma-timeline-item">
                <strong>1. Request</strong>
                <p>The patient creates a healthcare assistance request.</p>
            </div>

            <div class="ma-timeline-item">
                <strong>2. Validation</strong>
                <p>An expert validates sensitive requests when needed.</p>
            </div>

            <div class="ma-timeline-item">
                <strong>3. Proposal</strong>
                <p>An aidant sends a proposal to help.</p>
            </div>

            <div class="ma-timeline-item">
                <strong>4. Assignment</strong>
                <p>The patient accepts one proposal and the mission is assigned.</p>
            </div>

            <div class="ma-timeline-item">
                <strong>5. Proof</strong>
                <p>The aidant uploads proof after completing the intervention.</p>
            </div>

            <div class="ma-timeline-item">
                <strong>6. Verification</strong>
                <p>The patient verifies the mission before it becomes completed.</p>
            </div>
        </div>
    </section>

    <section class="ma-section ma-quality">
        <div class="ma-quality-content">
            <span>Project quality</span>
            <h2>Built as a serious academic and portfolio project</h2>
            <p>
                The project includes ASP.NET Core MVC, MongoDB, role-based authorization, cookie authentication,
                BCrypt password hashing, security headers, rate limiting, no-cache protection for sensitive pages,
                health check endpoint, and GitHub Actions CI.
            </p>
        </div>

        <div class="ma-quality-list">
            <div>
                <strong>Backend</strong>
                <span>ASP.NET Core MVC, services, controllers, MongoDB</span>
            </div>
            <div>
                <strong>Security</strong>
                <span>BCrypt, cookies, role protection, headers, rate limiting</span>
            </div>
            <div>
                <strong>Workflow</strong>
                <span>Request, proposal, mission, proof, verification</span>
            </div>
            <div>
                <strong>GitHub</strong>
                <span>README, CI workflow, docs, verification scripts</span>
            </div>
        </div>
    </section>
</div>

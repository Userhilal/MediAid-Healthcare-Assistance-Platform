@{
    ViewData["Title"] = "MediAid - Human Healthcare Support";
}

<link rel="stylesheet" href="~/css/home-pro.css" asp-append-version="true" />

<main class="mediaid-home">
    <section class="home-hero">
        <div class="hero-copy">
            <div class="eyebrow">
                <span></span>
                Human support, organized with care
            </div>

            <h1>
                Healthcare assistance made easier, safer, and more human.
            </h1>

            <p>
                MediAid helps patients ask for support, allows trusted helpers to offer assistance,
                and keeps every mission clear from request to completion.
            </p>

            <div class="hero-actions">
                <a asp-controller="Account" asp-action="Register" class="btn-main">
                    Get started
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn-soft">
                    Sign in
                </a>
            </div>

            <div class="hero-points">
                <div>
                    <strong>For patients</strong>
                    <span>Create requests and follow your support journey.</span>
                </div>
                <div>
                    <strong>For helpers</strong>
                    <span>Find meaningful missions and offer assistance.</span>
                </div>
                <div>
                    <strong>For teams</strong>
                    <span>Keep support organized, visible, and traceable.</span>
                </div>
            </div>
        </div>

        <div class="hero-visual" aria-label="MediAid process preview">
            <div class="floating-card main-card">
                <div class="card-top">
                    <span class="pulse"></span>
                    <span>Request journey</span>
                </div>

                <div class="journey-list">
                    <div class="journey-item active">
                        <span>1</span>
                        <div>
                            <strong>Ask for help</strong>
                            <small>Patient creates a support request</small>
                        </div>
                    </div>

                    <div class="journey-item">
                        <span>2</span>
                        <div>
                            <strong>Receive proposals</strong>
                            <small>Helpers can offer assistance</small>
                        </div>
                    </div>

                    <div class="journey-item">
                        <span>3</span>
                        <div>
                            <strong>Follow the mission</strong>
                            <small>Progress stays clear and organized</small>
                        </div>
                    </div>

                    <div class="journey-item">
                        <span>4</span>
                        <div>
                            <strong>Confirm completion</strong>
                            <small>Patient validates the support received</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mini-card mini-card-left">
                <strong>Clear status</strong>
                <span>Every request has a visible step.</span>
            </div>

            <div class="mini-card mini-card-right">
                <strong>Human care</strong>
                <span>Built around people, not complexity.</span>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="section-title">
            <span>What you can do</span>
            <h2>Simple spaces for every role</h2>
            <p>
                Each user has a focused experience with the actions they need most.
            </p>
        </div>

        <div class="role-grid">
            <article class="role-card">
                <div class="role-icon">P</div>
                <h3>Patient</h3>
                <p>Request support, review proposals, follow your mission, and confirm completion when help is received.</p>
            </article>

            <article class="role-card">
                <div class="role-icon">H</div>
                <h3>Helper</h3>
                <p>Browse available requests, offer help, manage missions, and provide proof after assistance.</p>
            </article>

            <article class="role-card">
                <div class="role-icon">E</div>
                <h3>Expert</h3>
                <p>Review sensitive requests and help keep the platform safer and more reliable.</p>
            </article>

            <article class="role-card">
                <div class="role-icon">A</div>
                <h3>Admin</h3>
                <p>Supervise users, monitor activity, and keep the platform organized.</p>
            </article>
        </div>
    </section>

    <section class="home-section process-section">
        <div class="section-title">
            <span>How it works</span>
            <h2>A guided support flow</h2>
            <p>
                MediAid keeps the assistance process structured, from the first request to the final confirmation.
            </p>
        </div>

        <div class="process-grid">
            <div class="process-step">
                <span>01</span>
                <strong>Create a request</strong>
                <p>The patient explains the type of help needed.</p>
            </div>

            <div class="process-step">
                <span>02</span>
                <strong>Choose support</strong>
                <p>Available helpers can send proposals.</p>
            </div>

            <div class="process-step">
                <span>03</span>
                <strong>Track progress</strong>
                <p>The mission status remains easy to follow.</p>
            </div>

            <div class="process-step">
                <span>04</span>
                <strong>Validate completion</strong>
                <p>The patient confirms that the mission is finished.</p>
            </div>
        </div>
    </section>

    <section class="home-section safety-section">
        <div class="safety-copy">
            <span>Designed for clarity</span>
            <h2>Less confusion. More confidence.</h2>
            <p>
                MediAid focuses on clear actions, readable pages, organized roles, and a calm interface
                that makes the support journey easier to understand.
            </p>
        </div>

        <div class="safety-list">
            <div>
                <strong>Organized requests</strong>
                <span>Patients can follow their support needs in one place.</span>
            </div>

            <div>
                <strong>Clear mission steps</strong>
                <span>Every mission moves through understandable stages.</span>
            </div>

            <div>
                <strong>Focused dashboards</strong>
                <span>Each role sees the actions that matter to them.</span>
            </div>
        </div>
    </section>
</main>

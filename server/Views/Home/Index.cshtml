        left: 0;
        right: 0;
        bottom: 0;
        z-index: 0;
        overflow: hidden;
    }

    .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.3;
        animation: blob-animation 20s infinite;
    }

    .blob-1 {
        width: 500px;
        height: 500px;
        background: rgba(14, 165, 233, 0.2);
        top: -200px;
        right: -100px;
        animation-delay: 0s;
    }

    .blob-2 {
        width: 400px;
        height: 400px;
        background: rgba(13, 148, 136, 0.2);
        bottom: -150px;
        left: -50px;

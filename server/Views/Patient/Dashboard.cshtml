@model MediAid.Services.PatientDashboardStats
@{
    ViewData["Title"] = "Tableau de bord Patient";
    var user = ViewBag.User as MediAid.Models.User;
    var patient = ViewBag.Patient as MediAid.Models.Patient;
    var activeRequests = ViewBag.ActiveRequests as List<MediAid.Models.Request> ?? new List<MediAid.Models.Request>();
    var conversations = ViewBag.Conversations as List<dynamic> ?? new List<dynamic>();
    var requestsToday = ViewBag.RequestsToday as List<MediAid.Models.Request> ?? new List<MediAid.Models.Request>();
    var requestsTomorrow = ViewBag.RequestsTomorrow as List<MediAid.Models.Request> ?? new List<MediAid.Models.Request>();
    var requestsThisWeek = ViewBag.RequestsThisWeek as List<MediAid.Models.Request> ?? new List<MediAid.Models.Request>();
    var requestHistory = ViewBag.RequestHistory as List<dynamic> ?? new List<dynamic>();
    var pendingFeedbackRequests = ViewBag.PendingFeedbackRequests as List<MediAid.Models.Request> ?? new List<MediAid.Models.Request>();
    var assignedAidant = ViewBag.AssignedAidant as MediAid.Models.Aidant;
    var assignedAidantUser = ViewBag.AssignedAidantUser as MediAid.Models.User;
    var totalUnreadMessages = ViewBag.TotalUnreadMessages as int? ?? 0;
    
    // Determine global status
    string globalStatusText = "Aucun besoin actif";
    string globalStatusClass = "status-none";
    string globalStatusIcon = "bi-check-circle-fill";
    
    if (activeRequests.Any(r => r.Status == "InProgress"))
    {
        globalStatusText = "Aide en cours";
        globalStatusClass = "status-progress";
        globalStatusIcon = "bi-activity";
    }
    else if (activeRequests.Any(r => r.Status == "Assigned"))
    {
        globalStatusText = "Aide planifiÃ©e";
        globalStatusClass = "status-planned";
        globalStatusIcon = "bi-calendar-check";
    }
    else if (activeRequests.Any(r => r.Status == "Open"))
    {
        globalStatusText = "En attente d'aide";
        globalStatusClass = "status-waiting";
        globalStatusIcon = "bi-clock-history";
    }
    
    // Get current time for greeting
    var hour = DateTime.Now.Hour;
    string greeting = hour < 12 ? "Bonjour" : hour < 18 ? "Bon aprÃ¨s-midi" : "Bonsoir";
    var currentTime = DateTime.Now.ToString("HH:mm");
    var currentDate = DateTime.Now.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"));
    
    // Trusted contacts
    var trustedContacts = new List<dynamic>();
    if (patient?.TrustedContacts != null && patient.TrustedContacts.Any())
    {
        foreach (var contact in patient.TrustedContacts)
        {
            trustedContacts.Add(new { Name = contact.Name, Relationship = contact.Relationship, Phone = contact.PhoneNumber });
        }
    }
    // Also include emergency contact if it exists
    if (patient?.EmergencyContact != null)
    {
        trustedContacts.Add(new { Name = patient.EmergencyContact.Name, Relationship = patient.EmergencyContact.Relationship, Phone = patient.EmergencyContact.PhoneNumber });
    }
}


@model MediAid.Models.User

@{
    ViewData["Title"] = "Mon compte";
}

<link rel="stylesheet" href="~/css/profile-professional.css" asp-append-version="true" />

<div class="profile-page-container">
    <div class="profile-header-professional">
        <div class="profile-title-section">
            <h1 class="profile-page-title">
                <i class="bi bi-person-circle"></i> Mon compte
            </h1>
            <p class="profile-page-subtitle">
                Gérez vos informations générales de connexion et d'identité.
            </p>
        </div>

        <a href="@Url.Action("Index", "Dashboard")" class="btn-back-dashboard">
            <i class="bi bi-arrow-left"></i> Retour au tableau de bord
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="profile-cards-grid">
        <div class="profile-card neumorphic-card">
            <div class="card-header-modern">
                <h2 class="card-title-modern">
                    <i class="bi bi-person-badge"></i> Informations du compte
                </h2>
                <p class="card-subtitle">
                    Ces informations sont communes à tous les rôles.
                </p>
            </div>

            <div class="card-body-modern">
                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-grid-modern">
                        <div class="form-group-modern">
                            <label class="form-label-modern">
                                <i class="bi bi-person"></i> Prénom
                            </label>
                            <input type="text" name="firstName" class="form-control-modern" value="@Model.FirstName" required />
                        </div>

                        <div class="form-group-modern">
                            <label class="form-label-modern">
                                <i class="bi bi-person"></i> Nom
                            </label>
                            <input type="text" name="lastName" class="form-control-modern" value="@Model.LastName" required />
                        </div>
                    </div>

                    <div class="form-grid-modern">
                        <div class="form-group-modern">
                            <label class="form-label-modern">
                                <i class="bi bi-envelope"></i> Email
                            </label>
                            <input type="email" class="form-control-modern" value="@Model.Email" readonly />
                            <small class="form-hint">
                                L'email est utilisé comme identifiant de connexion.
                            </small>
                        </div>

                        <div class="form-group-modern">
                            <label class="form-label-modern">
                                <i class="bi bi-telephone"></i> Téléphone
                            </label>
                            <input type="text" name="phoneNumber" class="form-control-modern" value="@Model.PhoneNumber" />
                        </div>
                    </div>

                    <div class="form-grid-modern">
                        <div class="form-group-modern">
                            <label class="form-label-modern">
                                <i class="bi bi-shield-check"></i> Rôle
                            </label>
                            <input type="text" class="form-control-modern" value="@Model.Role" readonly />
                        </div>

                        <div class="form-group-modern">
                            <label class="form-label-modern">
                                <i class="bi bi-calendar-check"></i> Compte créé le
                            </label>
                            <input type="text" class="form-control-modern" value="@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")" readonly />
                        </div>
                    </div>

                    <button type="submit" class="btn-primary-modern">
                        <i class="bi bi-check-circle"></i> Enregistrer
                    </button>
                </form>
            </div>
        </div>

        <div class="profile-card neumorphic-card">
            <div class="card-header-modern">
                <h2 class="card-title-modern">
                    <i class="bi bi-diagram-3"></i> Profil métier
                </h2>
                <p class="card-subtitle">
                    Accédez au profil spécifique à votre rôle.
                </p>
            </div>

            <div class="card-body-modern">
                @if (User.IsInRole("Patient"))
                {
                    <p class="form-hint">
                        Votre profil patient contient vos informations de santé, adresse, contact d'urgence et préférences de confidentialité.
                    </p>

                    <a asp-controller="Patient" asp-action="Profile" class="btn-primary-modern">
                        <i class="bi bi-heart-pulse"></i> Ouvrir mon profil patient
                    </a>
                }
                else if (User.IsInRole("Aidant"))
                {
                    <p class="form-hint">
                        Votre profil aidant contient votre bio, vos compétences, votre disponibilité, votre localisation et votre rayon d'intervention.
                    </p>

                    <a asp-controller="Aidant" asp-action="Profile" class="btn-primary-modern">
                        <i class="bi bi-person-heart"></i> Ouvrir mon profil aidant
                    </a>
                }
                else if (User.IsInRole("Expert"))
                {
                    <p class="form-hint">
                        Votre espace expert permet de superviser et valider les demandes nécessitant une expertise.
                    </p>

                    <a asp-controller="Expert" asp-action="Index" class="btn-primary-modern">
                        <i class="bi bi-shield-check"></i> Ouvrir l'espace expert
                    </a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <p class="form-hint">
                        Votre espace administrateur permet de gérer les utilisateurs, les demandes et l'activité globale.
                    </p>

                    <a asp-controller="Admin" asp-action="Index" class="btn-primary-modern">
                        <i class="bi bi-speedometer2"></i> Ouvrir l'administration
                    </a>
                }
                else
                {
                    <p class="form-hint">
                        Aucun profil métier spécifique n'est associé à ce compte.
                    </p>
                }
            </div>
        </div>
    </div>
</div>


@{
    ViewData["Title"] = "Déconnexion globale";
}

<div class="page-header-modern">
    <div>
        <h1 class="page-title">
            <i class="bi bi-box-arrow-right"></i> Déconnexion globale
        </h1>
        <p class="page-subtitle">Se déconnecter de tous les appareils</p>
    </div>
    <a href="@Url.Action("Index", "Profile")" class="btn-secondary-modern">
        <i class="bi bi-arrow-left"></i> Retour au profil
    </a>
</div>

<div class="logout-all-layout">
    <div class="card-modern neumorphic-card" style="border-left: 4px solid var(--color-warning);">
        <div class="card-header-modern">
            <h2 class="card-title-modern" style="color: var(--color-warning);">
                <i class="bi bi-box-arrow-right"></i> Déconnexion de tous les appareils
            </h2>
        </div>
        <div class="card-body-modern">
            <div class="alert-modern alert-warning-modern mb-4">
                <div style="display: flex; align-items: start; gap: var(--spacing-md);">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 1.5rem; flex-shrink: 0;"></i>
                    <div>
                        <strong>Attention :</strong> Cette action vous déconnectera de <strong>tous</strong> les appareils où vous êtes actuellement connecté(e) :
                        <ul style="margin: var(--spacing-sm) 0 0 var(--spacing-lg); padding-left: 0;">
                            <li>Ordinateur actuel</li>
                            <li>Tous les autres ordinateurs</li>
                            <li>Tous les smartphones et tablettes</li>
                            <li>Toutes les sessions actives</li>
                        </ul>
                        <p style="margin: var(--spacing-md) 0 0 0;">Vous devrez vous reconnecter sur chaque appareil.</p>
                    </div>
                </div>
            </div>

            <form asp-action="LogoutAll" method="post">
                @Html.AntiForgeryToken()
                <p style="font-size: var(--font-size-lg); color: var(--color-gray-700); margin-bottom: var(--spacing-xl);">
                    Êtes-vous sûr de vouloir vous déconnecter de tous les appareils ?
                </p>

                <div class="form-actions">
                    <a href="@Url.Action("Index", "Profile")" class="btn-secondary-modern">
                        <i class="bi bi-x-circle"></i> Annuler
                    </a>
                    <button type="submit" class="btn-warning-modern">
                        <i class="bi bi-check-circle"></i> Oui, me déconnecter partout
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .logout-all-layout {
        max-width: 700px;
        margin: 0 auto;
    }
</style>


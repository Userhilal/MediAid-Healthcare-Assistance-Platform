@model MediAid.DTOs.ChangeEmailDto
@{
    ViewData["Title"] = "Changer l'email";
}

<div class="page-header-modern">
    <div>
        <h1 class="page-title">
            <i class="bi bi-envelope"></i> Changer l'email
        </h1>
        <p class="page-subtitle">Mettez à jour votre adresse email</p>
    </div>
    <a href="@Url.Action("Index", "Profile")" class="btn-secondary-modern">
        <i class="bi bi-arrow-left"></i> Retour au profil
    </a>
</div>

<div class="email-change-layout">
    <div class="card-modern neumorphic-card">
        <div class="card-header-modern">
            <h2 class="card-title-modern">
                <i class="bi bi-envelope-at"></i> Nouveau email
            </h2>
        </div>
        <div class="card-body-modern">
            <form asp-action="ChangeEmail" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert-modern alert-danger-modern mb-4"></div>

                <div class="form-group-modern">
                    <label class="form-label-modern">Email actuel</label>
                    <input type="text" class="form-control-modern" value="@Model.CurrentEmail" disabled />
                </div>

                <div class="form-group-modern">
                    <label asp-for="NewEmail" class="form-label-modern">
                        <i class="bi bi-envelope-plus"></i> Nouveau email
                    </label>
                    <div class="input-wrapper">
                        <input asp-for="NewEmail" type="email" class="form-control-modern" required placeholder=" " />
                        <i class="bi bi-envelope input-icon"></i>
                        <label asp-for="NewEmail" class="input-label">Nouveau email</label>
                    </div>
                    <span asp-validation-for="NewEmail" class="field-validation"></span>
                </div>

                <div class="form-group-modern">
                    <label asp-for="Password" class="form-label-modern">
                        <i class="bi bi-lock"></i> Confirmer avec votre mot de passe
                    </label>
                    <div class="input-wrapper">
                        <input asp-for="Password" type="password" class="form-control-modern" required placeholder=" " />
                        <i class="bi bi-lock input-icon"></i>
                        <label asp-for="Password" class="input-label">Mot de passe</label>
                    </div>
                    <span asp-validation-for="Password" class="field-validation"></span>
                    <small class="form-hint">Veuillez confirmer votre mot de passe pour changer l'email</small>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("Index", "Profile")" class="btn-secondary-modern">
                        <i class="bi bi-x-circle"></i> Annuler
                    </a>
                    <button type="submit" class="btn-primary-modern">
                        <i class="bi bi-check-circle"></i> Changer l'email
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .email-change-layout {
        max-width: 600px;
        margin: 0 auto;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 1rem;
        color: #94A3B8;
        font-size: 1.125rem;
        z-index: 1;
        pointer-events: none;
        transition: color 0.3s ease;
    }

    .input-label {
        position: absolute;
        left: 3rem;
        top: 1rem;
        color: #94A3B8;
        font-size: 1rem;
        font-weight: 400;
        pointer-events: none;
        transition: all 0.3s ease-in-out;
        opacity: 0.6;
        background: white;
        padding: 0 0.25rem;
    }

    .form-control-modern:focus ~ .input-label,
    .form-control-modern:not(:placeholder-shown) ~ .input-label {
        top: -0.5rem;
        left: 2.75rem;
        font-size: 0.75rem;
        color: #10B981;
        opacity: 1;
        font-weight: 500;
    }

    .form-control-modern:focus ~ .input-icon,
    .form-control-modern:not(:placeholder-shown) ~ .input-icon {
        color: #10B981;
    }

    .form-control-modern {
        padding-left: 3rem;
    }

    .field-validation {
        display: block;
        color: var(--color-danger);
        font-size: var(--font-size-sm);
        margin-top: var(--spacing-xs);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


                        <label asp-for="Password" class="input-label">Mot de passe</label>
                    </div>
                    <span asp-validation-for="Password" class="field-validation"></span>
                    <small class="form-hint">Veuillez entrer votre mot de passe pour confirmer la suppression</small>
                </div>

                <div class="form-group-modern">
                    <div class="confirmation-checkbox">
                        <input asp-for="ConfirmDeletion" class="form-check-input" type="checkbox" id="confirmDeletion" />

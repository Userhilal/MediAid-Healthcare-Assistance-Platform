            </form>
        </div>
    </div>
</div>

<style>
    .delete-account-layout {
        max-width: 700px;
        margin: 0 auto;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 1rem;
        color: #94A3B8;
        font-size: 1.125rem;
        z-index: 1;
        pointer-events: none;
        transition: color 0.3s ease;
    }

    .input-label {
        position: absolute;
        left: 3rem;
        top: 1rem;
        color: #94A3B8;
        font-size: 1rem;
        font-weight: 400;
        pointer-events: none;
        transition: all 0.3s ease-in-out;
        opacity: 0.6;
        background: white;
        padding: 0 0.25rem;
    }

    .form-control-modern:focus ~ .input-label,
    .form-control-modern:not(:placeholder-shown) ~ .input-label {
        top: -0.5rem;
        left: 2.75rem;
        font-size: 0.75rem;
        color: #10B981;
        opacity: 1;
        font-weight: 500;
    }

    .form-control-modern:focus ~ .input-icon,
    .form-control-modern:not(:placeholder-shown) ~ .input-icon {
        color: #10B981;
    }

    .form-control-modern {
        padding-left: 3rem;
    }

    .confirmation-checkbox {
        padding: var(--spacing-lg);
        background: var(--color-gray-50);
        border-radius: var(--radius-md);
        border: 2px solid var(--color-gray-200);
    }

    .form-check-input {
        width: 1.25rem;
        height: 1.25rem;
        margin-right: var(--spacing-sm);
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
        user-select: none;
    }

    .field-validation {
        display: block;
        color: var(--color-danger);
        font-size: var(--font-size-sm);
        margin-top: var(--spacing-xs);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}







